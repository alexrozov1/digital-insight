---
const { href, title, date, excerpt, tags = [] } = Astro.props;
const iso = date ? new Date(date).toISOString() : null;
const display = date ? new Date(date).toLocaleDateString() : null;
---
<a href={href} class="group block rounded-xl border border-zinc-200 dark:border-zinc-800 bg-white/70 dark:bg-zinc-900/60 backdrop-blur-sm hover:shadow-sm transition-shadow p-5">
  {display && (
    <time datetime={iso} class="text-xs uppercase tracking-wide text-zinc-500 dark:text-zinc-400">{display}</time>
  )}
  <h3 class="mt-1 text-lg font-semibold text-zinc-900 dark:text-zinc-100 group-hover:text-cyan-600 dark:group-hover:text-cyan-400">
    {title}
  </h3>
  {excerpt && <p class="mt-2 line-clamp-3 text-sm text-zinc-600 dark:text-zinc-300">{excerpt}</p>}
  {tags?.length > 0 && (
    <ul class="mt-3 flex flex-wrap gap-1.5">
      {tags.map(t => <li class="px-2 py-0.5 text-xs rounded bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-300">{t}</li>)}
    </ul>
  )}
</a>
