---
import Layout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
const items = (await getCollection("cases"))
  .sort((a,b) => new Date(b.data.date) - new Date(a.data.date));
---
<Layout title="Cases">
  <section class="prose dark:prose-invert max-w-3xl mx-auto">
    <h1>Cases</h1>
    {items.length === 0 ? (
      <p>No cases yet.</p>
    ) : (
      <ul>
        {items.map(({ slug, data }) => (
          <li>
            <a href={`/cases/${slug}/`} class="no-underline hover:underline">
              {data.title}
            </a>
            <small class="block opacity-70">
              {new Date(data.date).toLocaleDateString()}
            </small>
            {data.excerpt && <p>{data.excerpt}</p>}
          </li>
        ))}
      </ul>
    )}
  </section>
</Layout>
