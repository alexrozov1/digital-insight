---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
const entries = (await getCollection("news"))
  .map(e => ({ ...e, _d: e.data.date ?? e.data.publishDate ?? null }))
  .sort((a,b) => {
    const ad = a._d ? +new Date(a._d) : 0;
    const bd = b._d ? +new Date(b._d) : 0;
    return bd - ad;
  });
---
<BaseLayout title="News">
  <section class="prose dark:prose-invert max-w-3xl mx-auto">
    <h1>News</h1>
    {entries.length === 0 ? (
      <p>No news yet.</p>
    ) : (
      <ul>
        {entries.map(({ slug, data, _d }) => (
          <li>
            <a href={`/news/${slug}/`} class="no-underline hover:underline">{data.title}</a>
            <small class="block opacity-70">{_d ? new Date(_d).toLocaleDateString() : "No date"}</small>
            {data.excerpt && <p>{data.excerpt}</p>}
          </li>
        ))}
      </ul>
    )}
  </section>
</BaseLayout>
